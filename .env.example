# ==============================================================================
# U-MARKET - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# En desarrollo local: copia este archivo como ".env" en la raíz del proyecto
# y completa tus valores reales. NUNCA subas el archivo ".env" a GitHub.
# En producción (Render): carga estas variables en Environment -> Environment Variables.
# ==============================================================================

# --- Servidor ---
PORT=8080

# --- Base de Datos ---
# En local (si se omiten, usa H2 en archivo ./data/utradedb por defecto):
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/utradedb
SPRING_DATASOURCE_DRIVER=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# Ejemplo para Producción con PostgreSQL (Render / Neon):
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/NOMBRE_BD?sslmode=require
# SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
# SPRING_DATASOURCE_USERNAME=usuario_postgres
# SPRING_DATASOURCE_PASSWORD=clave_postgres

# --- JPA y Consola H2 (usar false en producción) ---
JPA_DDL_AUTO=update
SHOW_SQL=true
H2_CONSOLE_ENABLED=true

# --- Seguridad JWT (usar una clave aleatoria de al menos 32 caracteres en producción) ---
JWT_SECRET=reemplaza-con-una-clave-secreta-de-al-menos-32-caracteres
JWT_EXPIRATION_MS=3600000

# --- CORS (orígenes permitidos separados por coma) ---
# Ejemplo producción: https://umarket-utp.vercel.app,http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Correo SMTP (local) / Brevo API HTTPS (producción en Render, donde SMTP 587 está bloqueado) ---
BREVO_API_KEY=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-app-password-de-gmail
